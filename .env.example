# Copy this file to ".env" and fill in ONE provider's key.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional
# PROVIDER=gemini        # or: claude (auto-detected from the key you filled)
# MODEL=                 # override the default model name
# ASSISTANT_PIN=         # your password for the web UI (random one is printed if empty)
# ASSISTANT_LANG=Hinglish
# HOST=0.0.0.0           # allow phone access on your Wi-Fi (default: this computer only)
# PORT=5000
